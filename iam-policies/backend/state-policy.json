{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListStateBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<BACKEND_BUCKET_NAME>",
      "Condition": {
        "StringLike": {
          "s3:prefix": "terraform/backend/*"
        }
      }
    },
    {
      "Sid": "ReadWriteStateFile",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::<BACKEND_BUCKET_NAME>/terraform/backend/resume_challenge"
    },
    {
      "Sid": "ManageStateLockFile",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::<BACKEND_BUCKET_NAME>/terraform/backend/resume_challenge.tflock"
    }
  ]
}
