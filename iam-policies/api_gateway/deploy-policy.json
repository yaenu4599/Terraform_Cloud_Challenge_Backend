{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Create",
      "Effect": "Allow",
      "Action": "apigateway:POST",
      "Resource": "arn:aws:apigateway:eu-central-1::/apis",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ManagedBy": "terraform",
          "aws:RequestTag/Project": "Terraform-Resume-Challange"
        },
        "StringLike": {
          "apigateway:Request/ApiName": "*-http-api"
        }
      }
    },
    {
      "Sid": "ManageApiAndChildren",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:POST",
        "apigateway:PATCH",
        "apigateway:PUT",
        "apigateway:DELETE"
      ],
      "Resource": "arn:aws:apigateway:eu-central-1::/apis/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ManagedBy": "terraform",
          "aws:ResourceTag/Project": "Terraform-Resume-Challange"
        }
      }
    },
    {
      "Sid": "ManageTags",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:PUT",
        "apigateway:POST",
        "apigateway:DELETE"
      ],
      "Resource": "arn:aws:apigateway:eu-central-1::/tags/*"
    },
    {
      "Sid": "TagChildResources",
      "Effect": "Allow",
      "Action": [
        "apigateway:TagResource",
        "apigateway:UntagResource"
      ],
      "Resource": "arn:aws:apigateway:eu-central-1::/apis/*"
    },
    {
      "Sid": "ProtectOwnershipTags",
      "Effect": "Deny",
      "Action": [
        "apigateway:DELETE",
        "apigateway:UntagResource"
      ],
      "Resource": [
        "arn:aws:apigateway:eu-central-1::/tags/*",
        "arn:aws:apigateway:eu-central-1::/apis/*"
      ],
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws:TagKeys": [
            "ManagedBy",
            "Project"
          ]
        }
      }
    }
  ]
}
