{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Create",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:TagResource"
      ],
      "Resource": "arn:aws:lambda:eu-central-1:<ACCOUNT_ID>:function:*-visitor-counter",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ManagedBy": "terraform",
          "aws:RequestTag/Project": "Terraform-Resume-Challange"
        }
      }
    },
    {
      "Sid": "ModifyDelete",
      "Effect": "Allow",
      "Action": [
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:DeleteFunction",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:TagResource",
        "lambda:UntagResource"
      ],
      "Resource": "arn:aws:lambda:eu-central-1:<ACCOUNT_ID>:function:*-visitor-counter",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ManagedBy": "terraform",
          "aws:ResourceTag/Project": "Terraform-Resume-Challange"
        }
      }
    },
    {
      "Sid": "ProtectOwnershipTags",
      "Effect": "Deny",
      "Action": "lambda:UntagResource",
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws:TagKeys": [
            "ManagedBy",
            "Project"
          ]
        }
      }
    },
    {
      "Sid": "Describe",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:GetFunctionRecursionConfig",
        "lambda:GetRuntimeManagementConfig",
        "lambda:ListVersionsByFunction",
        "lambda:GetPolicy",
        "lambda:ListTags"
      ],
      "Resource": "arn:aws:lambda:eu-central-1:<ACCOUNT_ID>:function:*-visitor-counter"
    },
    {
      "Sid": "PassOnlyTheLambdaRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/*-visitor-counter-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    }
  ]
}
