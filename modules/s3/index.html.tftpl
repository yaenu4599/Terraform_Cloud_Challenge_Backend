<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Yannik – Resume</title>
<link rel="icon" type="image/jpeg" href="paper.jpg">
<script>
  fetch('${api_gateway_url}', {
    method: 'POST'
  })
  .then(res => {
      return res.json();
  })
  .then( data => {
    document.getElementById('ViewerCount').innerText = data.ViewerCount;
  })
  .catch(error => console.log(error));

</script>
<style>
  :root {
    --text: #1f2328;
    --muted: #57606a;
    --border: #d8dee4;
    --accent: #2563eb;
    --bg: #ffffff;
  }

  * { box-sizing: border-box; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    color: var(--text);
    background: var(--bg);
    max-width: 760px;
    margin: 0 auto;
    padding: 48px 24px 80px;
    line-height: 1.5;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 12px;
    border-bottom: 2px solid var(--text);
    padding-bottom: 16px;
    margin-bottom: 28px;
  }

  h1 {
    font-size: 28px;
    margin: 0 0 4px 0;
  }

  .title {
    color: var(--muted);
    font-size: 16px;
  }

  .contact {
    text-align: right;
    font-size: 14px;
    color: var(--muted);
    line-height: 1.7;
  }

  .contact a {
    color: var(--accent);
    text-decoration: none;
  }

  .contact a:hover { text-decoration: underline; }

  section { margin-bottom: 28px; }

  h2 {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
    padding-bottom: 6px;
    margin-bottom: 14px;
  }

  .entry {
    margin-bottom: 16px;
  }

  .entry:last-child { margin-bottom: 0; }

  .entry-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 12px;
  }

  .entry-title {
    font-weight: 600;
    font-size: 15.5px;
  }

  .entry-sub {
    color: var(--muted);
    font-size: 14px;
  }

  .entry-date {
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
  }

  ul {
    margin: 8px 0 0 0;
    padding-left: 18px;
  }

  li {
    margin-bottom: 4px;
    font-size: 14.5px;
  }

  .certs {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  .cert {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 110px;
    text-decoration: none;
    color: var(--text);
    text-align: center;
  }

  .cert img {
    width: 90px;
    height: 90px;
    object-fit: contain;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 8px;
    margin-bottom: 6px;
  }

  .cert span {
    font-size: 12.5px;
    color: var(--muted);
  }

  p.summary {
    font-size: 14.5px;
    color: var(--text);
  }

  @media (max-width: 560px) {
    header { flex-direction: column; }
    .contact { text-align: left; }
  }
</style>
</head>
<body>

  <header>
    <div>
      <h1>Yannik Hofer</h1>
      <div class="title">IT Support Specialist</div>
    </div>
    <div class="contact">
      Bern, Switzerland<br>
      yannik.hofer@outlook.com<br>
      <a href="https://github.com/yaenu4599">github.com/yaenu4599</a><br>
      <a href="https://www.linkedin.com/in/yannik-hofer-9b845325a/">linkedin.com/in/yannik-hofer</a>
    </div>
  </header>

  <section>
    <h2>Summary</h2>
    <p class="summary">
      IT support professional with experience in hardware, software, and network troubleshooting.
      Currently building skills in cloud infrastructure and automation on the side.
    </p>
  </section>

  <section>
    <h2>Experience</h2>

    <div class="entry">
      <div class="entry-header">
        <span class="entry-title">IT Support Specialist</span>
        <span class="entry-date">2024 – Present</span>
      </div>
      <div class="entry-sub">Nestle Konolfingen, Bern Area</div>
      <ul>
        <li>Provided first- and second-level support for hardware, software, and network issues</li>
        <li>Documented recurring issues and solutions to reduce resolution time</li>
        <li>Supported infrastructure changes and rollouts</li>
      </ul>
    </div>

    <div class="entry">
      <div class="entry-header">
        <span class="entry-title">Apprenticeship IT Support Specialist</span>
        <span class="entry-date">2022 – 2024</span>
      </div>
      <div class="entry-sub">Frutiger AG, Bern Area</div>
      <ul>
        <li>Provided first-level support for hardware, software, and network issues</li>
        <li>Documented and resolved tickets, providing users with the necessary hardware</li>
      </ul>
    </div>
  </section>

  <section>
    <h2>Projects</h2>

    <div class="entry">
      <div class="entry-header">
        <span class="entry-title">Terraform AWS Module Library</span>
        <span class="entry-date">2026</span>
      </div>
      <div class="entry-sub">Personal / portfolio project</div>
      <ul>
        <li>Built reusable Terraform modules for common AWS infrastructure patterns</li>
        <li>Implemented CI/CD with GitHub Actions for automated validation and deployment</li>
      </ul>
    </div>
  </section>

  <section>
    <h2>Certifications</h2>
    <div class="certs">
      <a class="cert" href="https://www.credly.com/badges/97cb0a05-7e51-40a0-b8df-d564d9ff78f5/public_url" target="_blank">
        <img src="cert1.png" alt="Certification 1">
        <span>AWS Certified Solutions Architect – Associate</span>
      </a>
      <a class="cert" href="https://www.credly.com/badges/617821c8-86a7-41a8-b484-196848500133/public_url" target="_blank">
        <img src="cert2.png" alt="Certification 2">
        <span>HashiCorp Certified: Terraform Associate</span>
      </a>
      <a class="cert" href="https://www.credly.com/badges/b356d7f4-1962-4f8d-8070-90c1e5ac2eec/public_url">
        <img src="cert3.png" alt="Certification 3">
        <span>AWS Certified CloudOps Engineer – Associate</span>
      </a>
    </div>
  </section>

  <section>
    <h2>Education</h2>
    <div class="entry">
      <div class="entry-header">
        <span class="entry-title">ICT Specialist - Swiss Federal VET Diploma (EFZ - EQF Level 4)</span>
        <span class="entry-date">2021 – 2024</span>
      </div>
      <div class="entry-sub">WISS Schulen für Wirtschaft Informatik Immobilien</div>
    </div>
  </section>

  <section>
    <h2>Viewer count</h2>
    <div class="entry">
      <div class="entry-header">
        <span class="entry-title">People that visited my resume: </span>
        <span class="entry-date" id="ViewerCount" ></span>
      </div>
    </div>
  </section>

</body>
</html>
